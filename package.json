{
  "name": "md-game-editor",
  "version": "0.3.0",
  "private": true,
  "description": "Electron shell for Mega Drive game development",
  "main": "main.js",
  "scripts": {
    "copy-pkg": "node scripts/copy-pkg.js",
    "verify:standard-emulator-fps": "electron scripts/verify-standard-emulator-fps.js",
    "verify:bulletml-studio-ui": "electron scripts/verify-bulletml-studio-ui.js",
    "verify:bulletml-stg-wasm": "node scripts/verify-bulletml-stg-wasm.js",
    "inject-build-meta": "node scripts/inject-build-meta.js",
    "generate:md-novel-font-atlas": "electron scripts/generate-md-novel-default-font-atlas.js",
    "mcp": "node scripts/md-game-editor-mcp.js",
    "prepare:dist": "node scripts/prepare-dist.js",
    "test": "node tests/run-tests.js",
    "start": "node scripts/start-electron.js",
    "dev": "npm run start",
    "build:mac": "npm run prepare:dist && electron-builder --mac",
    "build:win": "npm run prepare:dist && electron-builder --win zip",
    "build:win:installer": "npm run prepare:dist && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "41.3.0",
    "electron-builder": "26.8.1"
  },
  "dependencies": {
    "iconv-lite": "0.6.3"
  }
}
